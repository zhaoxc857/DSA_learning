{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSA-Learning",
  "version": "1.0.0",
  "identifier": "io.github.zhaoxc857.dsalearning",
  "build": {
    "beforeDevCommand": "python sync_web.py",
    "beforeBuildCommand": "python sync_web.py",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "数据结构与算法 · 互动自学学院",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
